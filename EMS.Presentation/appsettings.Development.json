{
  "Jwt": {
    "Issuer": "EMS.API",
    "Audience": "EMS.Client",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Security": {
    "Headers": {
      "Hsts": {
        "Enabled": false
      },
      "Values": {
        "Content-Security-Policy": ""
      }
    },
    "Cookies": {
      "SecurePolicy": "SameAsRequest"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
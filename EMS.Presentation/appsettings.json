{
  "ConnectionStrings": {
    "EMS": "data source=192.168.200.6,2367;initial catalog=EMS;uid=pooldb;password=123qwe!@#;App=EntityFramework;TrustServerCertificate=true"
  },
  "Jwt": {
    "Issuer": "EMS.API",
    "Audience": "EMS.Client",
    "SecretKey": "THIS_IS_A_VERY_STRONG_SECRET_KEY_FOR_EMS_2026",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Maintenance": {
    "RefreshTokenCleanup": {
      "Enabled": true,
      "RetentionDays": 30,
      "IntervalHours": 24,
      "InitialDelayMinutes": 5,
      "BatchSize": 1000
    }
  },
  "Logging": {
    "SlowQueryThresholdMs": 500,
    "AuditTrail": {
      "Enabled": false
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ems-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "StartsWith(SourceContext, 'EMS.Security') or StartsWith(SourceContext, 'EMS.Audit')"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "logs/ems-security-.log",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 90,
                  "shared": true,
                  "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                }
              }
            ]
          }
        }
      }
    ]
  },
  "AllowedHosts": "*"
}